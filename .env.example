DATASETS_DIR=datasets
HPO_PATH=datasets/ontologies/hpo/hp.obo
MONDO_PATH=datasets/ontologies/mondo/mondo.obo
KG_PATH=datasets/kg.csv
DRUGCENTRAL_DIR=datasets/drugcentral
MEDQA_DIR=datasets/literature/MedQA
MEDMCQA_DIR=datasets/literature/MedMCQA
PUBMEDQA_DIR=datasets/literature/pubmedqa-master/pubmedqa-master
MEDBULLETS_DIR=datasets/literature/medbulltes5op

# The current graph retriever/importer still use fixed local Neo4j settings in code.
# Changing these example values alone does not reconfigure those scripts.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

QDRANT_URL=http://localhost:6333
VECTOR_COLLECTION_TEXTBOOKS=medical_textbooks
VECTOR_COLLECTION_PUBMEDQA=pubmedqa_contexts
VECTOR_COLLECTION_MEDQA=medqa_train
VECTOR_COLLECTION_GUIDELINES=clinical_guidelines
VECTOR_COLLECTION_DRUG_LABELS=clinical_drug_labels

# LLM fallback order: Gemini Flash Lite, Gemini Flash, Cohere, Mistral, OpenRouter.
GEMINI_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional web discovery; snippets are not accepted as claim citations.
SERPER_API_KEY=
